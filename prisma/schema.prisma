generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  galleries Gallery[]
}

model Gallery {
  id String @id @default(cuid())
  name String
  slug String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  photos Photo[]
  createdAt DateTime @default(now())
}

model Photo {
  id String @id @default(cuid())
  name String
  url String
  galleryId String
  gallery Gallery @relation(fields: [galleryId], references: [id])
}