generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  galleries Gallery[]
}

model Gallery {
  id String @id @default(cuid())
  name String
  slug String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  photos Photo[]
  coverPhotoId String? @unique
  coverPhoto Photo? @relation("GalleryCoverPhoto", fields: [coverPhotoId], references: [id])
  clientActions ClientPhotoAction[]
  settings Json?
  meta Json?
  createdAt DateTime @default(now())
}

model Photo {
  id String @id @default(cuid())
  name String
  url String
  galleryId String
  gallery Gallery @relation(fields: [galleryId], references: [id])
  favoriteCount Int @default(0)
  downloadCount Int @default(0)
  coverFor Gallery? @relation("GalleryCoverPhoto")
  clientActions ClientPhotoAction[]
}

model ClientPhotoAction {
  id String @id @default(cuid())
  galleryId String
  photoId String
  clientKey String
  clientName String?
  clientEmail String?
  action String
  createdAt DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id])
  photo Photo @relation(fields: [photoId], references: [id])

  @@unique([photoId, clientKey, action])
  @@index([galleryId])
}
